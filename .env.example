# BloomPrint — local secrets template.
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored, so it never gets committed. run.sh loads it on start,
# and anything already exported in your shell wins over a line here — so a
# stale value in this file can't override a fresh one you exported by hand.
#
# Leave a line blank or delete it if you aren't using that service. Nothing
# here is required for the app to boot except ANTHROPIC_API_KEY.


# ── AI ────────────────────────────────────────────────────────────────────────
# Required. From console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=


# ── Email (Resend) ────────────────────────────────────────────────────────────
# Feedback emails and, later, signup confirmations. Without these the app still
# works — feedback is saved to the database, it just isn't emailed to you.
#
# RESEND_API_KEY: resend.com → API Keys → Create. "Sending access" is enough.
# MAIL_FROM:      default sender. Must be on a domain verified in Resend.
# FEEDBACK_FROM:  sender for the notification that goes to you.
# FEEDBACK_TO:    the mailbox you read feedback in.
#
# FEEDBACK_FROM and FEEDBACK_TO must be DIFFERENT addresses. A message sent
# from a mailbox to itself, by way of a third-party sender, is treated as
# spoofing and bounces — that is not a misconfiguration you can fix later, it
# just silently loses every piece of feedback.
RESEND_API_KEY=
MAIL_FROM="BloomPrint <noreply@bloomprint.org>"
FEEDBACK_FROM="BloomPrint Feedback <feedback@bloomprint.org>"
FEEDBACK_TO=noreply@bloomprint.org


# ── Speech to text (Deepgram) ─────────────────────────────────────────────────
# Not wired up yet — this is here so the key has a home when it is.
# console.deepgram.com → API Keys.
DEEPGRAM_API_KEY=


# ── Google Sign-In (optional, not yet enabled) ────────────────────────────────
# GOOGLE_CLIENT_ID=


# ── File storage (optional) ───────────────────────────────────────────────────
# Uploaded film goes to a local ./uploads folder unless S3 is configured.
# Only needed once the API runs somewhere other than your Mac.
# STORAGE_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
